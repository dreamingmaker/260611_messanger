# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  (.env 는 .gitignore 에 의해 커밋되지 않습니다)
# 모든 값은 "선택" 입니다. 없으면 아래 기본값으로 동작합니다.
# ⚠ 실제 API 키는 절대 이 파일(.env.example)이나 소스에 적지 말고 .env 에만 두세요.

# ── 브라우저 UI / 네트워크 ─────────────────────────────
PORT=34567                       # 브라우저 UI 포트(사용 중이면 자동으로 다음 포트)
# DATA_DIR=data                  # 신원/대화/파일 저장 폴더
# DISCOVERY_ADDR=239.255.41.42   # 자동발견 멀티캐스트 그룹
# DISCOVERY_PORT=50505

# ── AI 요약용 LLM ──────────────────────────────────────
# 기본값 = 로컬 Ollama(gemma3:4b). 요약 대화가 외부로 나가지 않음. 각 PC에 Ollama 설치 + `ollama pull gemma3:4b` 필요.
LLM_URL=http://localhost:11434/v1/chat/completions
LLM_KEY=ollama
LLM_MODEL=gemma3:4b
LLM_PROVIDER=openai

# OpenAI 로 바꾸려면(클라우드 — 대화가 외부로 전송됨, 키 보안 주의):
#   LLM_URL=https://api.openai.com/v1/chat/completions
#   LLM_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=openai
#
# Claude 로 바꾸려면:
#   LLM_PROVIDER=anthropic
#   LLM_URL=https://api.anthropic.com/v1/messages
#   LLM_KEY=sk-ant-...
#   LLM_MODEL=claude-3-5-haiku-latest
